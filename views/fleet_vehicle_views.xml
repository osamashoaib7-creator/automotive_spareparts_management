<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_inherit_spareparts" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.spareparts</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Spare Parts" name="spare_parts">
                    <div class="mb-2" invisible="not id">
                        <button name="action_create_spare_part_quotation" type="object"
                                string="Create Quotation" class="btn-secondary"
                                groups="sales_team.group_sale_salesman"/>
                        <button name="action_view_sale_orders" type="object"
                                string="View Quotations" class="btn-link"
                                invisible="not sale_order_count"
                                groups="sales_team.group_sale_salesman"/>
                    </div>
                    <field name="sale_order_count" invisible="1"/>
                    <field name="spare_part_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="part_number"/>
                            <field name="warehouse_id" optional="show"/>
                            <field name="location_id" optional="show"/>
                            <field name="price"/>
                            <field name="quantity"/>
                            <field name="on_hand_qty" optional="show"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
