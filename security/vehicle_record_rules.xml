<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== VEHICLE ===== -->

    <!-- User: apni vehicles read/write/create (delete nahi) -->
    <record id="rule_vehicle_own_user" model="ir.rule">
        <field name="name">Vehicle: User sees own created vehicles</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- User: delete bilkul block -->
    <record id="rule_vehicle_no_delete_user" model="ir.rule">
        <field name="name">Vehicle: User cannot delete</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Manager: sab kuch, delete bhi -->
    <record id="rule_vehicle_all_manager" model="ir.rule">
        <field name="name">Vehicle: Manager full access</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
    </record>

    <!-- ===== SPARE PART ===== -->

    <record id="rule_spare_part_own_user" model="ir.rule">
        <field name="name">Spare Part: User sees own created parts</field>
        <field name="model_id" ref="model_fleet_spare_part"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_spare_part_no_delete_user" model="ir.rule">
        <field name="name">Spare Part: User cannot delete</field>
        <field name="model_id" ref="model_fleet_spare_part"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_spare_part_all_manager" model="ir.rule">
        <field name="name">Spare Part: Manager full access</field>
        <field name="model_id" ref="model_fleet_spare_part"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
    </record>

</odoo>