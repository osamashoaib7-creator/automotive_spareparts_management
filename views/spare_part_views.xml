<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_spare_part_tree" model="ir.ui.view">
        <field name="name">fleet.spare.part.tree</field>
        <field name="model">fleet.spare.part</field>
        <field name="arch" type="xml">
            <list string="Spare Parts" editable="bottom">
                <field name="name"/>
                <field name="part_number"/>
                <field name="vehicle_id"/>
                <field name="price"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_spare_part_form" model="ir.ui.view">
        <field name="name">fleet.spare.part.form</field>
        <field name="model">fleet.spare.part</field>
        <field name="arch" type="xml">
            <form string="Spare Part">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="part_number"/>
                        <field name="vehicle_id"/>
                        <field name="price"/>
                        <field name="quantity"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fleet_spare_part" model="ir.actions.act_window">
        <field name="name">Spare Parts</field>
        <field name="res_model">fleet.spare.part</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fleet_spare_part"
              name="Spare Parts"
              parent="fleet.fleet_vehicles"
              action="action_fleet_spare_part"
              sequence="1"/>
</odoo>