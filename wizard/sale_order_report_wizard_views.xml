<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_report_wizard_form" model="ir.ui.view">
<field name="name">sale.order.report.wizard.form</field>
<field name="model">sale.order.report.wizard</field>
<field name="arch" type="xml">
<form string="Sale Orders by Date">
<group>
<field name="date_from"/>
<field name="date_to"/>
</group>
<footer>
  <button string="View Orders" name="action_view_orders" type="object" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/>
<button string="Print PDF" name="action_print_pdf" type="object" class="btn-secondary"/>
                    <button string="Export Excel" name="action_export_excel" type="object" class="btn-success"/>
</footer>
</form>
</field>
</record>

<record id="action_sale_order_report_wizard" model="ir.actions.act_window">
<field name="name">Sale Orders by Date</field>
<field name="res_model">sale.order.report.wizard</field>
<field name="view_mode">form</field>
<field name="target">new</field>
</record>

<menuitem id="menu_sale_order_report_wizard"
name="Sale Orders by Date"
parent="sale.menu_sale_report"
action="action_sale_order_report_wizard"
sequence="50"/>
</odoo>